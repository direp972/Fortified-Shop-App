# Copy this file to .env and fill in your real values from Supabase
# (Project Settings > API in your Supabase dashboard).
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Server-side only — set it in the host's environment (Vercel project settings), never
# in the browser. Powers "Scan a Sketch" in the trim drawing tool (api/scan-sketch.js).
# ANTHROPIC_API_KEY=sk-ant-...
